# Database
DB_PATH=.data/focus-tracker.db

# Next.js
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Spotify Integration (Optional)
# Get these from https://developer.spotify.com/dashboard
# 1. Create an app in Spotify Developer Console
# 2. Copy the Client ID below
# 3. Set Redirect URI to http://localhost:3000 (or your deployment URL)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000

